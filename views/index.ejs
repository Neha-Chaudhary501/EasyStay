    <div>
           <a href="/listing/new/">
  <button>New</button>
</a>

 <div class="row row-cols-lg-3 row-cols-md-2 wor-cols-sm-1">
        
<% data.forEach((listing) => { %>
<div class="card" style="width: 20rem;">
  <img src="https://img.magnific.com/free-photo/closeup-shot-beautiful-butterfly-with-interesting-textures-orange-petaled-flower_181624-7640.jpg?semt=ais_hybrid&w=740&q=80" class="card-img-top" alt="card-image">
  <div class="card-body">
    <h5 class="card-title"><%= listing.title %></h5>
    <p class="card-text"><%=listing.description%></p>
    <p class="card-text"><%=listing.price%>/day</p>
    <a href="" class="btn btn-primary"></a>
    <a href="/user/<%= listing._id %>">Go to full details</a>
     
  </div>

</div>
<% }) %>
 </div>




</div>
