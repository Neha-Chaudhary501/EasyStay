<% layout("layout/boilerplate")%>

<body>

    <form method="POST" action="/listing/update/<%= listing._id %>?_method=PUT">

        <input type="text" 
               value="<%= listing.title %>" 
               name="listing[title]"> 
        <br><br>

        <textarea name="listing[description]"><%= listing.description %></textarea>
        <br><br>

        <input type="number" 
               value="<%= listing.price %>" 
               name="listing[price]">  
        <br><br>

        <input type="text" 
               value="<%= listing.location %>" 
               name="listing[location]">  
        <br><br>

        <input type="text" 
               value="<%= listing.country %>" 
               name="listing[country]"> 
        <br><br>
          <input type="text" 
               value="<%= listing.image %>" 
               name="listing[image]"> 
               <br><br>

        <button>Edit</button>

    </form>

</body>
