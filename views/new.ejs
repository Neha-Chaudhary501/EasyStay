<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>form</title>
</head>
<body>
    <form method="POST" action="/listing/new" >
          <input type="text" name="listing[title]" placeholder="Title"> 
          <br> <br>
          <textarea type="text" name="listing[description]" placeholder="Description"> </textarea>
          <br> <br>
          <input type="number" name="listing[price]" placeholder="Price">  
          <br> <br>
          <input type="text" name="listing[location]" placeholder="location">  
          <br> <br>
          <input type="text" name="country" placeholder="country"> 
  
          <br> <br>
          <button type="submit">Create Listing</button>
          </form>

</body>
</html>