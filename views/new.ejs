<% layout("layout/boilerplate")%>
    <div class="row">
        <div class="col-8" offset-2>
            <form method="POST" action="/listing/new" class="row g-3 needs-validation" novalidate>
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="listing[title]" placeholder="Title" class="form-control" id="title">
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Discription</label>
                    <textarea type="text" name="listing[description]" placeholder="Description" class="form-control"
                        id="description"> </textarea>
                </div>

                <div class="row">

                    <div class="mb-3 col-4">
                        <label for="price" class="form-label">Price</label>
                        <input type="text" name="listing[price]" placeholder="price" class="form-control" id="price">
                    </div>

                    <div class="mb-3 col-8">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" name="listing[location]" placeholder="location" class="form-control"
                            id="location">
                    </div>

                </div>

                <div class="mb-3">
                    <label for="country" class="form-label">country</label>
                    <input type="text" name="listing[country]" placeholder="country" class="form-control" id="country">
                </div>

                <div>
                    <label for="image" class="form-label">Image</label>
                    <input type="text" name="listing[image]" placeholder="image" class="form-control" id="image">
                </div>
                <br><br>

                <button class="btn add-btn w-auto">Add</button>
            </form>

        </div>
    </div>